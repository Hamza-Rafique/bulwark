{
  "name": "bulwark",
  "version": "1.0.0",
  "description": "AI-powered PR analysis and test generation for GitHub",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "send-invites": "node scripts/send-invites.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:init": "node scripts/init-db.js"
  },
  "keywords": [
    "github",
    "github-app",
    "ai",
    "code-review",
    "test-generation",
    "pr-review"
  ],
  "author": "Hamza Rafique",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@babel/parser": "^7.29.8",
    "@babel/traverse": "^7.29.8",
    "@babel/types": "^7.29.8",
    "@octokit/app": "^16.1.4",
    "@octokit/rest": "^21.1.1",
    "@octokit/webhooks": "^13.9.1",
    "@slack/webhook": "^8.0.2",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.2",
    "lowdb": "^7.0.1",
    "node-persist": "^4.0.4",
    "openai": "^4.104.0",
    "sqlite3": "^5.1.7",
    "vm2": "^3.11.7",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6"
  },
  "nodemonConfig": {
    "watch": [
      "app.js",
      "src/",
      "*.json"
    ],
    "ext": "js,json",
    "ignore": [
      "node_modules/",
      "*.test.js"
    ]
  }
}
